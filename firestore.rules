      allow update: if memberAccount() && (
        (owner(resource.data.ownerUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked == true)
        || (ticket(hash) && resource.data.usedBy == '' && resource.data.revoked == false
          && resource.data.createdAt + duration.value(15,'m') > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']) && request.resource.data.usedBy == request.auth.uid
