    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function deletedIncident(uid, id) {
      return exists(/databases/$(database)/documents/users/$(uid)/deleted_incidents/$(id));
    }
    function endedOrMissing(path) {
      return !exists(path) || get(path).data.status in ['RESOLVED','CANCELLED','Resolved','Cancelled'];
    }
    function memberAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function pairId(a, b) { return hashing.sha256(a < b ? a + ':' + b : b + ':' + a).toHexString().lower(); }
    function ticket(hash) {
      let t = get(/databases/$(database)/documents/spark_circle_lookups/$(request.auth.uid)).data;
      return memberAccount() && t.codeHash == hash && t.requestedAt > request.time - duration.value(1, 'm');
    }
    function activeCode(hash) {
      let c = get(/databases/$(database)/documents/spark_circle_codes/$(hash)).data;
      return c.revoked == false && c.createdAt + duration.value(15, 'm') > request.time
        && get(/databases/$(database)/documents/spark_circle_code_owners/$(c.ownerUid)).data.codeHash == hash;
    }
    function budget(limit) {
      let n = request.resource.data;
      return n.count is int && n.count >= 1 && n.count <= limit && n.windowStart is timestamp
        && ((resource == null
             && n.count == 1 && n.windowStart == request.time)
          || (resource != null && ((resource.data.windowStart <= request.time - duration.value(15, 'm')
                 && n.count == 1 && n.windowStart == request.time)
            || (resource.data.windowStart > request.time - duration.value(15, 'm')
                 && n.count == resource.data.count + 1 && n.windowStart == resource.data.windowStart))));
    }
    function accepted(relationId, a, b, version) {
      let r = get(/databases/$(database)/documents/circle_relationships/$(relationId)).data;
      return r.status == 'ACCEPTED' && a != b && a in r.participants && b in r.participants && version == r.createdAt;
    }
    function canViewLocation(uid) {
      let grant = get(/databases/$(database)/documents/users/$(uid)/circle_members/$(request.auth.uid)).data;
      return signedIn() && grant.shareEnabled == true && grant.expiresAt > request.time
        && accepted(grant.relationId, uid, request.auth.uid, grant.relationshipCreatedAt);
    }
    match /public_profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['name', 'photoUrl'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow delete: if owner(uid);
    }
    match /spark_circle_code_owners/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid) && memberAccount()
        && request.resource.data.keys().hasOnly(['code','codeHash','issuedAt','windowStart','count'])
        && request.resource.data.code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$')
        && request.resource.data.codeHash == hashing.sha256(request.resource.data.code).toHexString().lower()
        && request.resource.data.issuedAt == request.time && budget(10)
        && getAfter(/databases/$(database)/documents/spark_circle_codes/$(request.resource.data.codeHash)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/spark_circle_codes/$(request.resource.data.codeHash)).data.createdAt == request.time;
    }
    match /spark_circle_lookups/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid) && memberAccount() && budget(5)
        && request.resource.data.keys().hasOnly(['codeHash','requestedAt','windowStart','count'])
        && request.resource.data.codeHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.requestedAt == request.time;
    }
    match /spark_circle_codes/{hash} {
      allow get: if memberAccount() && (ticket(hash) || owner(resource.data.ownerUid));
      allow list, delete: if false;
      allow create: if memberAccount()
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt','revoked','usedBy'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.revoked == false && request.resource.data.usedBy == ''
        && getAfter(/databases/$(database)/documents/spark_circle_code_owners/$(request.auth.uid)).data.codeHash == hash;
      allow update: if memberAccount() && (
        (owner(resource.data.ownerUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true)
        || (ticket(hash) && activeCode(hash) && resource.data.usedBy == '' && resource.data.ownerUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/circle_relationships/$(pairId(resource.data.ownerUid, request.auth.uid))).data.codeHash == hash
          && getAfter(/databases/$(database)/documents/circle_relationships/$(pairId(resource.data.ownerUid, request.auth.uid))).data.status == 'PENDING'
          && getAfter(/databases/$(database)/documents/circle_relationships/$(pairId(resource.data.ownerUid, request.auth.uid))).data.createdAt == request.time));
    }
    match /circle_relationships/{id} {
      function lookupPair() {
        let h = get(/databases/$(database)/documents/spark_circle_lookups/$(request.auth.uid)).data.codeHash;
        let c = get(/databases/$(database)/documents/spark_circle_codes/$(h)).data;
        return ticket(h) && id == pairId(c.ownerUid, request.auth.uid);
      }
      function redeem() {
        let n = request.resource.data;
        let c = get(/databases/$(database)/documents/spark_circle_codes/$(n.codeHash)).data;
        return memberAccount() && n.keys().hasOnly(['participants','senderUid','recipientUid','status','codeHash','createdAt','updatedAt','expiresAt'])
          && n.recipientUid == request.auth.uid && n.senderUid != n.recipientUid && n.senderUid == c.ownerUid
          && n.participants == [n.senderUid, n.recipientUid] && id == pairId(n.senderUid, n.recipientUid)
          && n.status == 'PENDING' && n.createdAt == request.time && n.updatedAt == request.time
          && n.expiresAt == c.createdAt + duration.value(15, 'm')
          && ticket(n.codeHash) && activeCode(n.codeHash) && c.usedBy == ''
          && getAfter(/databases/$(database)/documents/spark_circle_codes/$(n.codeHash)).data.usedBy == request.auth.uid;
      }
      allow get: if memberAccount() && ((resource != null && request.auth.uid in resource.data.participants) || lookupPair());
      allow list: if memberAccount() && request.auth.uid in resource.data.participants;
      allow create: if redeem();
      allow update: if memberAccount() && (
        (resource.data.status in ['REJECTED','REVOKED'] && redeem())
        || (resource.data.status == 'PENDING' && resource.data.expiresAt <= request.time && redeem())
        || (request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.status == 'REVOKED' && resource.data.status in ['PENDING','ACCEPTED'])
            || (resource.data.status == 'PENDING' && request.auth.uid == resource.data.recipientUid
              && (request.resource.data.status == 'REJECTED' ||
